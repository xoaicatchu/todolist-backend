{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "TodoSync": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=6432;Database=todosync;Username=postgres;Password=postgres;Timeout=15;CommandTimeout=30;Pooling=true;MinPoolSize=10;MaxPoolSize=50;No Reset On Close=true;Multiplexing=false;SSL Mode=Disable;Max Auto Prepare=0;",
    "Redis": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost:5672",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Cache": {
    "DefaultExpirationMinutes": 5,
    "SlidingExpirationMinutes": 2
  },
  "RateLimit": {
    "SyncWrite": {
      "PermitLimit": 1000,
      "WindowSeconds": 10,
      "QueueLimit": 5000
    },
    "SyncRead": {
      "PermitLimit": 3000,
      "WindowSeconds": 10,
      "QueueLimit": 10000
    }
  },
  "OpenTelemetry": {
    "ServiceName": "TodoSync.Api",
    "ServiceVersion": "2.0.0",
    "PrometheusPort": 9090
  },
  "Outbox": {
    "PollIntervalMs": 500,
    "BatchSize": 100,
    "MaxRetries": 5
  }
}
